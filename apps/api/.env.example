# Environment name only; real secrets belong in the local/CI secret store.
APP_ENV=local
# API base URL is public in browser bundles; do not put secrets here.
API_BASE_URL=http://localhost:8080
# Optional: connection URL for an isolated PostgreSQL review database in local/test.
# REVIEW_DATABASE_URL=
# Optional Kavenegar provider (when both values are set, local/test sends real SMS).
# Keep the API key in the secret store; never commit it.
# KAVENEGAR_API_KEY=
# KAVENEGAR_TEMPLATE=marketplace_login
# KAVENEGAR_BASE_URL=https://api.kavenegar.com
