# Environment name only; real secrets belong in the local/CI secret store.
APP_ENV=local
# API base URL is public in browser bundles; do not put secrets here.
API_BASE_URL=http://localhost:8080
# Optional: connection URL for an isolated PostgreSQL review database in local/test.
# REVIEW_DATABASE_URL=
# Optional Kavenegar provider (when both values are set, local/test sends real SMS).
# Keep the API key in the secret store; never commit it.
# KAVENEGAR_API_KEY=
# KAVENEGAR_TEMPLATE=marketplace_login
# KAVENEGAR_BASE_URL=https://api.kavenegar.com

# Web entry: backoffice (default) or storefront. Storefront serves per-category initial HTML metadata.
# WEB_SURFACE=storefront
# WEB_ROOT=../storefront-web/build

# Optional bind host; use 127.0.0.1 for the shared local review account.
BIND_HOST=

# Public environment: production + a separate empty live database + OTP provider are required.
# DATABASE_URL=
# Never set DATABASE_URL together with REVIEW_DATABASE_URL; local/test cannot open live data.
# Bootstrap only via the one-shot CLI; supply CHERRIVA_BOOTSTRAP_PASSWORD from a secret store.
